{
  "name": "agent-explainer",
  "version": "0.1.0-beta.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-scenarios.ts",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate && npm run build"
  },
  "keywords": [],
